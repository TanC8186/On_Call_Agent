            "type": "string",
            "description": "服务名称（必填）"
          },
          "instance_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "CVM 实例 ID（可选，如 ins-xxxxxxxx）\n         腾讯云 API 需要实例 ID 来查询 CVM 指标。\n         如果不提供，将使用 service_name 作为维度值查询自定义指标。"
          },
          "start_time": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "开始时间（可选，格式 \"YYYY-MM-DD HH:MM:SS\"，默认1小时前）"
          },
          "end_time": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "结束时间（可选，格式 \"YYYY-MM-DD HH:MM:SS\"，默认当前时间）"
          },
          "interval": {
            "default": "1m",
            "type": "string",
            "description": "数据聚合间隔（可选，\"1m\"/\"5m\"/\"1h\"，默认 \"1m\"）"
          },
          "region_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "地区代码（可选，默认 ap-beijing）"
          }
        },
        "required": [
          "service_name"
        ],
        "type": "object"
      }
    },
